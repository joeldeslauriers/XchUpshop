/* Validate if the current order is part of a vendor we have to send to their endpoint */
@WIZRPL(UNFIGREENWOODORDER=@DBSELECT(SELECT 1 FROM REC_HDR WHERE F27='3954'  AND F1032=@DBHOT(HOT_IDX,F1032) AND F1067='CLOSE' AND F1068='ORDER' AND F902 LIKE '%Upshop%' AND (F1254 IS NULL OR F1254 NOT LIKE '%SentToVendor%')));
@WIZRPL(MACERIORDER=@DBSELECT(SELECT 1 FROM REC_HDR WHERE F27='10987' AND F1032=@DBHOT(HOT_IDX,F1032) AND F1067='CLOSE' AND F1068='ORDER' AND F902 LIKE '%Upshop%' AND (F1254 IS NULL OR F1254 NOT LIKE '%SentToVendor%')));
@WIZRPL(LIPARIORDER=@DBSELECT(SELECT 1 FROM REC_HDR WHERE F27='10950' AND F1032=@DBHOT(HOT_IDX,F1032) AND F1067='CLOSE' AND F1068='ORDER' AND F902 LIKE '%Upshop%' AND (F1254 IS NULL OR F1254 NOT LIKE '%SentToVendor%')));
@WIZRPL(UNFIRACINEORDER=@DBSELECT(SELECT 1 FROM REC_HDR WHERE F27='7313'  AND F1032=@DBHOT(HOT_IDX,F1032) AND F1067='CLOSE' AND F1068='ORDER' AND F902 LIKE '%Upshop%' AND (F1254 IS NULL OR F1254 NOT LIKE '%SentToVendor%')));


@FMT(CMP,@WIZGET(UNFIGREENWOODORDER)=1,®EXEC(EXE='@RUNXchUpShop\pushSMSPOtoUNFI.exe "@DBHOT(HOT_IDX,F1032)" "@DBHOT(HOT_IDX,F27)"'));
@FMT(CMP,@WIZGET(MACERIORDER)=1,®EXEC(EXE='@RUNXchUpShop\pushSMSPOtoMACERI.exe "@DBHOT(HOT_IDX,F1032)" "@DBHOT(HOT_IDX,F27)"'));
@FMT(CMP,@WIZGET(LIPARIORDER)=1,®EXEC(EXE='@RUNXchUpShop\pushSMSPOtoLIPARI.exe "@DBHOT(HOT_IDX,F1032)" "@DBHOT(HOT_IDX,F27)"'));
@FMT(CMP,@WIZGET(UNFIRACINEORDER)=1,®EXEC(EXE='@RUNXchUpShop\pushSMSPOtoUNFI.exe "@DBHOT(HOT_IDX,F1032)" "@DBHOT(HOT_IDX,F27)"'));

