@WIZSET(TITLE=UPSHOP - PO STATUS (DETAIL));
@WIZRPL(STYLE=O1R);
@WIZRPL(TEMPLATE=RAVYX_PO_STATUS);

@WIZINIT;
@WIZDATES(START,STOP);
@WIZRPL(VENDOR=);
@WIZRPL(PO=);
@WIZDISPLAY;

@RPT_QUERY
SELECT F254,CAST(F1032 AS varchar(20)) AS F1032,CAST(F91 AS varchar(20)) AS F91,CAST(F27 AS varchar(14)) AS F27,F334,F29,CASE WHEN ISNULL(F03,0)=1 THEN '' ELSE F1081 END AS F1081,F03 FROM dbo.RAVYX_PO_STATUS WHERE F254 BETWEEN '@WIZGET(START)' AND DATEADD(DAY,1,'@WIZGET(STOP)') AND (ISNULL('@WIZGET(VENDOR)','')='' OR F27='@WIZGET(VENDOR)') AND ((ISNULL('@WIZGET(PO)','')='' AND ((ISNULL(F27,0)<>0 AND ISNULL(F91,0)<>0) OR (ISNULL(F27,0)=0 AND F29='FAILED'))) OR (ISNULL('@WIZGET(PO)','')<>'' AND F91='@WIZGET(PO)')) ORDER BY F254 DESC,F27,F91;



