@WIZSET(TITLE=UPSHOP - PO STATUS (DETAIL));
@WIZRPL(STYLE=O1R);
@WIZRPL(TEMPLATE=RAVYX_PO_STATUS);

@WIZINIT;
@WIZDATES(START,STOP);
@WIZRPL(VENDOR=);
@WIZRPL(PO=);
@WIZDISPLAY;

@RPT_QUERY
SELECT S.F254, CAST(S.F1032 AS varchar(20)) AS F1032, CAST(S.F91 AS varchar(20)) AS F91, CAST(S.F27 AS varchar(14)) AS F27, CAST(ISNULL((SELECT TOP 1 V.F334 FROM dbo.VENDOR_TAB V WHERE V.F27 = S.F27),'') AS varchar(60)) AS F334, S.F02, S.F29, CASE WHEN ISNULL(S.F03,0)=1 THEN '' ELSE S.F1081 END AS F1081, S.F03 FROM dbo.RAVYX_PO_STATUS S WHERE S.F254 >= '@WIZGET(START)' AND S.F254 < DATEADD(DAY,1,'@WIZGET(STOP)') AND (ISNULL('@WIZGET(VENDOR)','')='' OR CAST(S.F27 AS varchar(14))='@WIZGET(VENDOR)') AND (ISNULL('@WIZGET(PO)','')='' OR CAST(S.F91 AS varchar(20))='@WIZGET(PO)' OR CAST(S.F1032 AS varchar(20))='@WIZGET(PO)') ORDER BY S.F254 DESC, S.F27, S.F91




