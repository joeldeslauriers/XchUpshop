<?xml version="1.0" encoding="iso-8859-1"?>

<html>
  <head>
    <desc>
      <input type="hidden" class="HidParam" id="RPT_NAME" value="UPSHOP - PO STATUS" />
      <input type="hidden" class="HidParam" id="RPT_FILENAME" value="RAVYX_PO_STATUS" />
      <input type="hidden" class="HidParam" id="RPT_PARENT" value="rpt_trs_rec" />
      <input type="hidden" class="HidParam" id="RPT_PRIORITY" value="10" />
      <input type="hidden" class="HidParam" id="RPT_DESC" value="Displays the Upshop import status by PO/Vendor (success/failed + message)." />
      <input type="hidden" class="HidParam" id="RPT_GROUP" value="7.Inventory" />
      <input type="hidden" class="HidParam" id="RPT_WIZARD" value="yes" />
    </desc>

    <meta http-equiv="Content-Type" content="text/html; charset=iso-8859-1" />
    <meta name="CurHdr" content="ScreenRpt" />
    <meta http-equiv="expires" content="0" />
    <meta http-equiv="PRAGMA" content="No_Cache" />

    <link rel="stylesheet" href="../../Images/sms_form.css" type="text/css" />
    <link rel="stylesheet" href="../../Images/sms_rpt.css" type="text/css" />

    <script type="text/javascript" src="../../Images/rpt.js"></script>
    <title></title>
  </head>

  <body class="Main" onload="@wizset(CURPOS=0)InitRpt(document,@wizget(CURPOS),'@dbHot(DBALIAS)','@DBHOT(DBUSERNAME)','@DBHOT(DBPASSWORD)','http:/scripts/trs.exe')">

    <object class="ComDialog" id="cDialog" classid="clsid:327DC737-2BAD-48A3-9B4E-B42D5378C78A"></object>

    <table class="HdrTab">
      <tbody>
        <tr>
          <th class="HdrCel" id="RptTitle">UPSHOP - PO STATUS</th>

          <th class="HdrBtnCel">
            <input class="HdrBtnNew" accesskey="Z" onclick="SubmitReport('@wizget(DN)')" type="button" value="Lancer" name="BtnSubmit"
              onkeydown="ReadKeyStroke(window,this)" onblur="LeaveField(this)" onfocus="ActivateField(this)" />
          </th>

          <th class="HdrBtnCel">
            <input class="HdrBtnNew" onclick="PrintReport('@wizget(DN)')" type="button" value="Imprimer" name="BtnPrint"
              onkeydown="ReadKeyStroke(window,this)" onblur="LeaveField(this)" onfocus="ActivateField(this)" />
          </th>

          <th class="HdrBtnCel">
            <input class="HdrBtnNew" onclick="ReportAddTo(this,'@wizget(DN)','T')" type="button" value="Ajouter" name="BtnTask"
              onkeydown="ReadKeyStroke(window,this)" onblur="LeaveField(this)" onfocus="ActivateField(this)" />
          </th>

          <th class="HdrBtnCel">
            <input class="HdrBtnNew"
              onclick="document.location='http:/scripts/trs.exe?htt=sqr\\' + RPT_FILENAME.value + '.rpt&amp;CN=@CNC&amp;TN=@TER';"
              type="button" value="Réinitialiser" name="BtnReset"
              onkeydown="ReadKeyStroke(window,this)" onblur="LeaveField(this)" onfocus="ActivateField(this)" />
          </th>
        </tr>
      </tbody>
    </table>

    <!-- PÉRIODE -->
    <table class="EntTab" style="LEFT: 50px; POSITION: absolute; TOP: 70px">
      <tbody>
        <tr>
          <th class="EntHdr" colspan="2">PERIOD</th>
        </tr>
        <tr>
          <td class="EntPeriod" id="oPeriodSrc"
              detail_periods="@dbhot(DETAIL_PERIODS)"
              detail_names="@dbhot(DETAIL_NAMES)"
              detail_details="@dbhot(DETAIL_DETAILS)"
              initval="@wizset(DETAIL=1)@wizget(DETAIL)">
          </td>
        </tr>
      </tbody>
    </table>

    <!-- PLAGE DE DATES -->
    <table class="EntTab" style="LEFT: 200px; POSITION: absolute; TOP: 70px">
      <tbody>
        <tr>
          <th class="EntHdr" id="oDateSrc" colspan="4"
              initval="@wizset(REFRESH_DATE=1)@wizget(REFRESH_DATE)"
              initformat="@dbHOT(REGIONAL,SHORTDATEFORMAT)"
              initformatsql="@dbHOT(REGIONAL,SQLDATEFORMAT)"
              initweek="@dbHOT(WEEKSTART)"
              initdatereg="@wizset(DATE=@DWDD)@wizget(DATE)">
            Date Range
          </th>
          <td></td>
        </tr>

        <tr>
          <th class="EntCap">Start</th>
          <td class="EntInp">
            <input class="EntDat" style="WIDTH: 90px" name="START" value="@wizget(START)"
              ondblclick="ShowDateExt(window,this,'Select a date','D')"
              onchange="ValidateField(window,this,'date')"
              onfocus="SaveValue(this)" onkeydown="ReadKeyStroke(window,this)" onblur="LeaveField(this)" />
          </td>

          <td class="EntVal" style="PADDING-RIGHT: 0px; PADDING-LEFT: 0px; PADDING-BOTTOM: 0px; WIDTH: 0%; PADDING-TOP: 0px" rowspan="2">
            <input class="EntBtn" style="WIDTH: 60px" onclick="GotoNextPreviousDate('-')" type="button" value="Passé" name="BtnDatPas"
              onkeydown="ReadKeyStroke(window,this)" onblur="LeaveField(this)" onfocus="ActivateField(this)" />
            <br />
            <input class="EntBtn" style="WIDTH: 60px" onclick="GotoNextPreviousDate('+')" type="button" value="Futur" name="BtnDatFut"
              onkeydown="ReadKeyStroke(window,this)" onblur="LeaveField(this)" onfocus="ActivateField(this)" />
          </td>
        </tr>

        <tr>
          <th class="EntCap">End</th>
          <td class="EntInp">
            <input class="EntDat" style="WIDTH: 90px" name="STOP" value="@wizget(STOP)"
              ondblclick="ShowDateExt(window,this,'Select a date','F')"
              onchange="ValidateField(window,this,'date')"
              onfocus="SaveValue(this)" onkeydown="ReadKeyStroke(window,this)" onblur="LeaveField(this)" />
          </td>
        </tr>

        <tr>
          <td class="EntVal" id="oDateDesc" colspan="4"></td>
        </tr>
      </tbody>
    </table>

    

    <!-- PARAMS -->
    <input class="HidParam" type="hidden" value="RAVYX_PO_STATUS" name="SQR" />
    <input class="HidParam" type="hidden" value="@CNC" name="CN" />
    <input class="HidParam" type="hidden" value="@TER" name="TN" />

  </body>
</html>
